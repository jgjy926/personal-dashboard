# ── Privacy: NEVER publish your KLSE trading data ───────────────────────────
# klse.json is your private book. It stays local (feeds the snapshot when you run
# the dashboard on your own machine) and behind the access-keyed tunnel online —
# it must never land in a public repo or on a public host.
data/klse.json

# Card-promo working files (raw scrape, per-bank drafts, the LLM prompt) — only
# the merged data/promos/<feed>.json files are published.
data/campaign_raw/
data/promos/*.draft.json
data/campaign_prompt.txt

# OS / editor / python cruft
.DS_Store
Thumbs.db
__pycache__/
*.pyc
.venv/

# Local Cloudflare Wrangler state (account id/email, tokens) — never publish
.wrangler/

# Editor/tooling backups
*.bak

# Worker deps, if you ever npm-install locally
worker/**/node_modules/

# Air-quality fallback snapshot: the tab reads APIMS live from worker/apims-proxy;
# refresh.yml publishes this copy with each deploy without committing it.
# Run tools/fetch_apims.py for a local copy.
data/apims.json
